Panels:
  - Class: rviz_common/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
      Splitter Ratio: 0.5
    Tree Height: 525
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
        baseline_robot/base_link:
          Value: true
        baseline_robot/cg_link:
          Value: true
        baseline_robot/dvl:
          Value: true
        baseline_robot/dvl_sf:
          Value: true
        baseline_robot/gps:
          Value: true
        baseline_robot/heave_bow_thruster_link:
          Value: true
        baseline_robot/heave_stern_thruster_link:
          Value: true
        baseline_robot/imu:
          Value: true
        baseline_robot/imu_sf:
          Value: true
        baseline_robot/mbes_link_sf:
          Value: true
        baseline_robot/nose_tip_link:
          Value: true
        baseline_robot/odom:
          Value: true
        baseline_robot/ping360_link:
          Value: true
        baseline_robot/pressure:
          Value: true
        baseline_robot/surge_thruster_link:
          Value: true
        baseline_robot/sway_bow_thruster_link:
          Value: true
        baseline_robot/world:
          Value: true
        baseline_robot/world_ned:
          Value: true
        world_ned:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        baseline_robot/world:
          baseline_robot/odom:
            baseline_robot/base_link:
              baseline_robot/cg_link:
                {}
              baseline_robot/dvl:
                {}
              baseline_robot/dvl_sf:
                {}
              baseline_robot/gps:
                {}
              baseline_robot/heave_bow_thruster_link:
                {}
              baseline_robot/heave_stern_thruster_link:
                {}
              baseline_robot/imu:
                {}
              baseline_robot/imu_sf:
                {}
              baseline_robot/nose_tip_link:
                baseline_robot/mbes_link_sf:
                  {}
              baseline_robot/ping360_link:
                {}
              baseline_robot/pressure:
                {}
              baseline_robot/surge_thruster_link:
                {}
              baseline_robot/sway_bow_thruster_link:
                {}
          baseline_robot/world_ned:
            world_ned:
              {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /baseline_robot/robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        cg_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        dvl:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        dvl_sf:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        gps:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        heave_bow_thruster_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        heave_stern_thruster_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        imu:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        imu_sf:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        mbes_link_sf:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        nose_tip_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ping360_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        pressure:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        surge_thruster_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        sway_bow_thruster_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
      Mass Properties:
        Inertia: false
        Mass: false
      Name: AUV
      TF Prefix: baseline_robot
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 100
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.05000000074505806
      Name: EKF trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /baseline_robot/navigation/path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 180; 0
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.05000000074505806
      Name: Virtual GPS truth (evaluation only)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /baseline_robot/navigation/truth_path
      Value: true
    - Alpha: 0.85
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 185; 120; 255
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.04
      Name: USBL acoustic fixes (1 Hz)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 185; 120; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /baseline_robot/navigation/usbl_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: baseline_robot/odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30.708646774291992
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 10
        Y: 10
        Z: -3
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.0553977489471436
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.7703980207443237
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1043
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1920
  X: 132
  Y: 64
