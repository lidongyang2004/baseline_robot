<?xml version='1.0' encoding='utf-8'?>
<scenario>
  <environment>
    <ned latitude="41" longitude="-71"/>
    <ocean>
      <water density="1023.0" jerlov="0.2"/>
      <particles enabled="true"/>
      <current type="uniform">
        <velocity xyz="0.0 0.0 0.0"/>
      </current>
    </ocean>
    <atmosphere>
      <sun azimuth="40.0" elevation="10.0"/>
    </atmosphere>
  </environment>
  <include file="$(find world_of_stonefish)/metadata/materials.scn"/>
  <include file="$(find world_of_stonefish)/metadata/looks.scn"/>
  <include file="$(find baseline_robot_bringup)/scenarios/baseline_robot.scn">
    <arg name="robot_name" value="baseline_robot"/>
    <arg name="position_x" value="0.0"/>
    <arg name="position_y" value="0.0"/>
    <arg name="position_z" value="-0.5"/>
  </include>
  <!-- Fixed acoustic reference, not another vehicle. Native USBL uses PING/ACK. -->
  <comm name="baseline_robot/usbl_station" device_id="1" type="usbl">
    <specs min_vertical_fov="0.0" max_vertical_fov="360.0" range="1000.0"/>
    <connect device_id="2" occlusion_test="false"/>
    <autoping rate="1.0"/>
    <noise range="0.05" horizontal_angle="0.2" vertical_angle="0.5"/>
    <!-- Disable truncation quantization for the Gaussian-noise experiment. -->
    <resolution range="0.0" angle="0.0"/>
    <world_transform xyz="-10.0 -5.0 1.0" rpy="0.0 0.0 0.0"/>
    <ros_publisher topic="baseline_robot/stonefish/usbl"/>
  </comm>
  <!-- A bottom within DVL range provides a bottom-track target. NED z is down. -->
  <static name="seabed" type="box">
    <dimensions xyz="400.0 400.0 1.0"/>
    <material name="Rock"/>
    <look name="gray"/>
    <world_transform xyz="0.0 0.0 30.5" rpy="0.0 0.0 0.0"/>
  </static>
</scenario>
